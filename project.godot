config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="chipsong test"
config/version="0.1.3"
run/main_scene="uid://dhdf837ii684c"
config/use_custom_user_dir=true
config/custom_user_dir_name="chipsong-test"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=30
config/icon="uid://dj7l0gywbd8p2"

[autoload]

Graphics="*res://scripts/graphics.gd"
Game="*res://scripts/game/game.tscn"
Ui="*res://scripts/ui/ui.tscn"

[display]

window/size/viewport_width=128
window/size/viewport_height=128
window/size/always_on_top=true
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor]

movie_writer/video_quality=1.0
movie_writer/movie_file="D:/rhy/code/godot/builds/chipsong/out.avi"

